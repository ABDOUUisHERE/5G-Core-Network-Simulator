            "targetPort": 16686,
            "nodePort": 30686
          },
          {
            "name": "otlp",
            "port": 4318,
            "targetPort": 4318
          },
          {
            "name": "otlp-grpc",
            "port": 4317,
            "targetPort": 4317
          }
        ],
        "type": "NodePort"
      }
    }
  ]
}

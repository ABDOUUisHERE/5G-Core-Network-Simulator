    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "control-api",
        "namespace": "core5g"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "control-api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "control-api"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "control-api",
                "image": "core5g:local",
                "imagePullPolicy": "Never",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "core5g-config"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "SERVICE",
                    "value": "control-api"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  },
                  {
                    "containerPort": 50051
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": 8080
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 10
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "48Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "192Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "control-api",
        "namespace": "core5g"
      },
      "spec": {
        "selector": {
          "app": "control-api"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30085
          },
          {
            "name": "grpc",
            "port": 50051,
            "targetPort": 50051
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "prometheus-config",
        "namespace": "core5g"
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 5s\nscrape_configs:\n  - job_name: core5g\n    static_configs:\n      - targets: ['udm:8080', 'ausf:8080', 'amf:8080', 'smf:8080', 'upf:8080', 'gnb-simulator:8080', 'control-api:8080']\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "core5g"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.2.1",
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "core5g"
      },
      "spec": {
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "name": "http",
            "port": 9090,
            "targetPort": 9090,
            "nodePort": 30090
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "grafana-config",
        "namespace": "core5g"
      },
      "data": {
        "datasource.yml": "apiVersion: 1\ndatasources:\n  - name: Prometheus\n    uid: core5g-prometheus\n    type: prometheus\n    access: proxy\n    url: http://prometheus:9090\n    isDefault: true\n    editable: false\n",
        "provider.yml": "apiVersion: 1\nproviders:\n  - name: Core5G\n    folder: Core5G\n    type: file\n    options:\n      path: /etc/grafana/provisioning/dashboards\n",
        "core5g.json": "{\n \"uid\":\"core5g-overview\",\"title\":\"Core5G \u2014 Network Lab\",\"schemaVersion\":39,\"version\":1,\"refresh\":\"5s\",\"tags\":[\"core5g\"],\"time\":{\"from\":\"now-15m\",\"to\":\"now\"},\n \"panels\":[\n  {\"id\":1,\"type\":\"stat\",\"title\":\"Registered UE\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":0,\"y\":0,\"w\":6,\"h\":5},\"targets\":[{\"expr\":\"core5g_registered_ues\",\"refId\":\"A\"}]},\n  {\"id\":2,\"type\":\"stat\",\"title\":\"Active PDU sessions\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":6,\"y\":0,\"w\":6,\"h\":5},\"targets\":[{\"expr\":\"core5g_active_sessions\",\"refId\":\"A\"}]},\n  {\"id\":3,\"type\":\"stat\",\"title\":\"Lost packets\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":12,\"y\":0,\"w\":6,\"h\":5},\"targets\":[{\"expr\":\"core5g_packets_total{result=\\\"lost\\\"}\",\"refId\":\"A\"}]},\n  {\"id\":4,\"type\":\"stat\",\"title\":\"Injected faults\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":18,\"y\":0,\"w\":6,\"h\":5},\"targets\":[{\"expr\":\"sum(core5g_fault_enabled)\",\"refId\":\"A\"}]},\n  {\"id\":5,\"type\":\"timeseries\",\"title\":\"RPC p95 latency by service (seconds)\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":0,\"y\":5,\"w\":12,\"h\":8},\"targets\":[{\"expr\":\"histogram_quantile(0.95, sum by (le,service) (rate(core5g_rpc_duration_seconds_bucket[1m])))\",\"legendFormat\":\"{{service}}\",\"refId\":\"A\"}]},\n  {\"id\":6,\"type\":\"timeseries\",\"title\":\"RPC errors per second\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":12,\"y\":5,\"w\":12,\"h\":8},\"targets\":[{\"expr\":\"sum by (service,code) (rate(core5g_rpc_requests_total{code!=\\\"OK\\\"}[1m]))\",\"legendFormat\":\"{{service}} {{code}}\",\"refId\":\"A\"}]},\n  {\"id\":7,\"type\":\"timeseries\",\"title\":\"Virtual packet outcomes\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":0,\"y\":13,\"w\":12,\"h\":8},\"targets\":[{\"expr\":\"rate(core5g_packets_total[1m])\",\"legendFormat\":\"{{result}}\",\"refId\":\"A\"}]},\n  {\"id\":8,\"type\":\"timeseries\",\"title\":\"Scrape availability\",\"datasource\":{\"type\":\"prometheus\",\"uid\":\"core5g-prometheus\"},\"gridPos\":{\"x\":12,\"y\":13,\"w\":12,\"h\":8},\"targets\":[{\"expr\":\"up{job=\\\"core5g\\\"}\",\"legendFormat\":\"{{instance}}\",\"refId\":\"A\"}]}\n ]\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "grafana",
        "namespace": "core5g"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "grafana"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "grafana"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "grafana",
                "image": "grafana/grafana:11.6.0",
                "ports": [
                  {
                    "containerPort": 3000
                  }
                ],
                "env": [
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
                    "value": "Viewer"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_PASSWORD",
                    "value": "local-lab-grafana"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/datasources/prometheus.yml",
                    "subPath": "datasource.yml"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/dashboards/provider.yml",
                    "subPath": "provider.yml"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/dashboards/core5g.json",
                    "subPath": "core5g.json"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "grafana-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "grafana",
        "namespace": "core5g"
      },
      "spec": {
        "selector": {
          "app": "grafana"
        },
        "ports": [
          {
            "name": "http",
            "port": 3000,
            "targetPort": 3000,
            "nodePort": 30030
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "jaeger",

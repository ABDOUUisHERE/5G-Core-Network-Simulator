{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "core5g"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "core5g-config",
        "namespace": "core5g"
      },
      "data": {
        "GRPC_ADDR": ":50051",
        "HTTP_ADDR": ":8080",
        "RPC_TIMEOUT": "2s",
        "REQUEST_TIMEOUT": "5s",
        "SEED_SUBSCRIBERS": "1000",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4318",
        "GRAFANA_URL": "http://127.0.0.1:3006",
        "PROMETHEUS_URL": "http://127.0.0.1:9096",
        "JAEGER_URL": "http://127.0.0.1:16687",
        "UDM_ADDR": "udm:50051",
        "AUSF_ADDR": "ausf:50051",
        "AMF_ADDR": "amf:50051",
        "SMF_ADDR": "smf:50051",
        "UPF_ADDR": "upf:50051",
        "GNB_ADDR": "gnb-simulator:50051"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "core5g-migrations",
        "namespace": "core5g"
      },
      "data": {
        "001_initial.sql": "-- Schema ownership is explicit. Credentials below are synthetic local-lab values.\nCREATE ROLE core5g_udm LOGIN PASSWORD 'local-lab-udm';\nCREATE ROLE core5g_amf LOGIN PASSWORD 'local-lab-amf';\nCREATE ROLE core5g_smf LOGIN PASSWORD 'local-lab-smf';\nCREATE ROLE core5g_upf LOGIN PASSWORD 'local-lab-upf';\nCREATE SCHEMA udm AUTHORIZATION core5g_udm;\nCREATE SCHEMA amf AUTHORIZATION core5g_amf;\nCREATE SCHEMA smf AUTHORIZATION core5g_smf;\nCREATE SCHEMA upf AUTHORIZATION core5g_upf;\n\nCREATE TABLE udm.subscribers (\n id TEXT PRIMARY KEY, data JSONB NOT NULL,\n supi VARCHAR(32) GENERATED ALWAYS AS (data->>'supi') STORED UNIQUE NOT NULL,\n status VARCHAR(24) GENERATED ALWAYS AS (data->>'status') STORED NOT NULL CHECK(status IN ('ENABLED','DISABLED')),\n auth_profile VARCHAR(80) GENERATED ALWAYS AS (data->>'auth_profile') STORED NOT NULL,\n CHECK(id=supi)\n);\nCREATE TABLE amf.equipments (\n id TEXT PRIMARY KEY, data JSONB NOT NULL,\n ue_id UUID GENERATED ALWAYS AS ((data->>'ue_id')::uuid) STORED UNIQUE NOT NULL,\n supi VARCHAR(32) GENERATED ALWAYS AS (data->>'supi') STORED NOT NULL,\n state VARCHAR(24) GENERATED ALWAYS AS (data->>'state') STORED NOT NULL CHECK(state IN ('DISCONNECTED','REGISTERING','REGISTERED','SESSION_ACTIVE')),\n CHECK(id=ue_id::text)\n);\nCREATE TABLE amf.registrations (id TEXT PRIMARY KEY, data JSONB NOT NULL);\nCREATE TABLE amf.session_events (id TEXT PRIMARY KEY, data JSONB NOT NULL);\nCREATE TABLE smf.sessions (\n id TEXT PRIMARY KEY, data JSONB NOT NULL,\n session_id UUID GENERATED ALWAYS AS ((data->>'session_id')::uuid) STORED UNIQUE NOT NULL,\n request_id UUID GENERATED ALWAYS AS ((data->>'request_id')::uuid) STORED UNIQUE NOT NULL,\n ue_id UUID GENERATED ALWAYS AS ((data->>'ue_id')::uuid) STORED NOT NULL,\n ip_address INET GENERATED ALWAYS AS (NULLIF(data->>'ip_address','')::inet) STORED,\n state VARCHAR(24) GENERATED ALWAYS AS (data->>'state') STORED NOT NULL CHECK(state IN ('CREATING','ACTIVE','RELEASING','RELEASED','FAILED')),\n CHECK(id=session_id::text)\n);\nCREATE UNIQUE INDEX uq_active_ip ON smf.sessions(ip_address) WHERE state IN ('CREATING','ACTIVE','RELEASING') AND ip_address IS NOT NULL;\nCREATE INDEX session_ue ON smf.sessions(ue_id);\nCREATE TABLE upf.routes (id TEXT PRIMARY KEY, data JSONB NOT NULL);\nCREATE TABLE upf.settings (id TEXT PRIMARY KEY, data JSONB NOT NULL);\nGRANT SELECT,INSERT,UPDATE ON ALL TABLES IN SCHEMA udm TO core5g_udm;\nGRANT SELECT,INSERT,UPDATE ON ALL TABLES IN SCHEMA amf TO core5g_amf;\nGRANT SELECT,INSERT,UPDATE ON ALL TABLES IN SCHEMA smf TO core5g_smf;\nGRANT SELECT,INSERT,UPDATE ON ALL TABLES IN SCHEMA upf TO core5g_upf;\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "core5g-local-lab",
        "namespace": "core5g"
      },
      "type": "Opaque",
      "stringData": {
        "postgres-password": "local-lab-admin",
        "udm-url": "postgres://core5g_udm:local-lab-udm@postgres:5432/core5g?sslmode=disable",
        "amf-url": "postgres://core5g_amf:local-lab-amf@postgres:5432/core5g?sslmode=disable",
        "smf-url": "postgres://core5g_smf:local-lab-smf@postgres:5432/core5g?sslmode=disable",
        "upf-url": "postgres://core5g_upf:local-lab-upf@postgres:5432/core5g?sslmode=disable"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-data",
        "namespace": "core5g"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "core5g"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16-alpine",
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "core5g"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "core5g"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "core5g-local-lab",
                        "key": "postgres-password"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "core5g"
                    ]
                  },
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "migrations",
                    "mountPath": "/docker-entrypoint-initdb.d",
                    "readOnly": true
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data"
                }
              },
              {
                "name": "migrations",
                "configMap": {
                  "name": "core5g-migrations"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "core5g"
      },
      "spec": {
        "selector": {
          "app": "postgres"
        },
        "ports": [
          {
